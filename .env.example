DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp?schema=public"

# ==============================================================================
# AUTHENTICATION MODES
# ==============================================================================
# Mode 1: Secure Production Mode
# - Leave NEXT_PUBLIC_DEV_MOCK_ROLE empty.
# - Enforces PostgreSQL database session adapter, strict 30-min idle timeout, and cryptographic binding.
#
# Mode 2: Flexible Local Dev Mode
# - Set to any Nigerian role for instantaneous, zero-login testing across modules.
# - Options: "Bursar", "Principal", "Headmaster", "Class Teacher", "Professor", "Lecturer", "Student", "SUPER_ADMIN"
NEXT_PUBLIC_DEV_MOCK_ROLE="Bursar"

# Cryptographic Token Secret
JWT_SECRET_KEY="schoolerp-secret-key-change-in-production-environments"

# ==============================================================================
# NEXTAUTH.JS & GOOGLE OAUTH CONFIGURATION
# ==============================================================================
# NextAuth canonical base URL and session encryption secret
NEXTAUTH_URL="https://bonaveeict.com.ng"
NEXT_PUBLIC_APP_URL="https://bonaveeict.com.ng"
NEXT_PUBLIC_ROOT_DOMAIN="bonaveeict.com.ng"
NEXTAUTH_SECRET="schoolerp-nextauth-super-secret-key-change-in-production"

# Google Developer Console OAuth 2.0 Credentials:
# 1. Visit: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web Application)
# 3. Authorized JavaScript Origins: http://localhost:3000
# 4. Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Django Backend API URL
NEXT_PUBLIC_DJANGO_API_URL="http://localhost:8000/api/v1"

# ==============================================================================
# EMAIL NOTIFICATIONS CONFIGURATION (Resend API or SMTP)
# ==============================================================================
# Option 1: Resend (Recommended - https://resend.com)
RESEND_API_KEY=""

# Option 2: Custom SMTP (Gmail, Brevo, SendGrid, Mailgun)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Sender Display
EMAIL_FROM="School ERP <onboarding@resend.dev>"


