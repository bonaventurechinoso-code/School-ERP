DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp?schema=public"

# ==============================================================================
# AUTHENTICATION MODES
# ==============================================================================
# Mode 1: Secure Production Mode
# - Leave NEXT_PUBLIC_DEV_MOCK_ROLE empty.
# - Enforces PostgreSQL database session adapter, strict 30-min idle timeout, and cryptographic binding.
#
# Mode 2: Flexible Local Dev Mode
# - Set to any Nigerian role for instantaneous, zero-login testing across modules.
# - Options: "Bursar", "Principal", "Headmaster", "Class Teacher", "Professor", "Lecturer", "Student", "SUPER_ADMIN"
NEXT_PUBLIC_DEV_MOCK_ROLE="Bursar"

# Cryptographic Token Secret
JWT_SECRET_KEY="schoolerp-secret-key-change-in-production-environments"

# Django Backend API URL
NEXT_PUBLIC_DJANGO_API_URL="http://localhost:8000/api/v1"
