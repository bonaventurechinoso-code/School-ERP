# ==============================================================================
# DATABASE CONFIGURATION (3 Environments)
# ==============================================================================
# 1. Production Database: Render Postgres (Managed) - configured ONLY in Render Dashboard
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.render.com/DATABASE?sslmode=require"
#
# 2. Local Sandbox Database (For local developer workstation only):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_erp_sandbox?schema=public"
SANDBOX_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_erp_sandbox?schema=public"
#
# 3. Demo Playground Database (Separate dedicated instance on Render for /demo):
DEMO_DATABASE_URL="postgresql://USER:PASSWORD@DEMO_HOST.render.com/demo_db?sslmode=require"

# ==============================================================================
# AUTHENTICATION MODES
# ==============================================================================
# Mode 1: Secure Production Mode
# - Leave NEXT_PUBLIC_DEV_MOCK_ROLE empty.
# - Enforces PostgreSQL database session adapter, strict 30-min idle timeout, and cryptographic binding.
#
# Mode 2: Flexible Local Dev Mode
# - Set to any Nigerian role for instantaneous, zero-login testing across modules.
# - Options: "Bursar", "Principal", "Headmaster", "Class Teacher", "Professor", "Lecturer", "Student", "SUPER_ADMIN"
NEXT_PUBLIC_DEV_MOCK_ROLE="Bursar"

# Cryptographic Token Secret
JWT_SECRET_KEY="schoolerp-secret-key-change-in-production-environments"

# ==============================================================================
# NEXTAUTH.JS & GOOGLE OAUTH CONFIGURATION
# ==============================================================================
# NextAuth canonical base URL and session encryption secret
NEXTAUTH_URL="https://bonaveeict.com.ng"
NEXT_PUBLIC_APP_URL="https://bonaveeict.com.ng"
NEXT_PUBLIC_ROOT_DOMAIN="bonaveeict.com.ng"
NEXTAUTH_SECRET="schoolerp-nextauth-super-secret-key-change-in-production"

# Google Developer Console OAuth 2.0 Credentials:
# 1. Visit: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web Application)
# 3. Authorized JavaScript Origins: http://localhost:3000
# 4. Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Django Backend API URL
NEXT_PUBLIC_DJANGO_API_URL="http://localhost:8000/api/v1"

# ==============================================================================
# TRANSACTIONAL EMAIL CONFIGURATION (Resend API or SMTP)
# ==============================================================================
# Emails are dispatched across tenant registration, student enrollment,
# staff onboarding, password resets, and admissions.
#
# Option 1: Resend API (Recommended - https://resend.com)
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=""

# Option 2: Custom SMTP (Gmail, Brevo, SendGrid, Mailgun, Amazon SES)
# Accepted aliases: MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_ENCRYPTION
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Sender Address & Display Name
# Note: For SMTP (e.g., Gmail), the email MUST match your authenticated SMTP_USER.
EMAIL_FROM="School ERP <noreply@bonaveeict.com.ng>"
EMAIL_FROM_NAME="School ERP"

# Super Admin Alert Destination
SUPER_ADMIN_EMAIL="admin@bonaveeict.com.ng"

# ==============================================================================
# WEB PUSH & VAPID CONFIGURATION
