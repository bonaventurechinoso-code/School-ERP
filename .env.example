NEXT_PUBLIC_VAPID_PUBLIC_KEY="BNK2ox07rKAH9VDCtSJjEIYM55OeoHzKKHI5e8DvAj-l2cZ5z9kibNgJwMGpg3AB7E3TqSbmo1sU1oLfRdAN0Fo"
VAPID_PRIVATE_KEY="uoakQG0c8Qwl_sqSegwHff2RPQw_icx_4gNl-9aBth4"
VAPID_SUBJECT="mailto:admin@bonaveeict.com.ng"

